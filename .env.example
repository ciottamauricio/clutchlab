# Laravel
APP_NAME=Clutchlab
APP_ENV=local
APP_KEY=                       # generated by artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=postgres               # service name, not localhost
DB_PORT=5432
DB_DATABASE=clutchlab
DB_USERNAME=clutch
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379
# Empty so Laravel doesn't prefix keys — Go BLPOPs the raw queue name below.
REDIS_PREFIX=

# MinIO speaks the S3 API, so Laravel's s3 driver just works
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=demos
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Plain Redis list both languages agree on (cross-language queue)
PARSE_QUEUE=demo_parse_jobs
