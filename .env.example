# Laravel
APP_NAME=Clutchlab
APP_ENV=local
APP_KEY=                       # generated by artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=postgres               # service name, not localhost
DB_PORT=5432
DB_DATABASE=clutchlab
DB_USERNAME=clutch             # owner: runs migrations, owns the public (app) schema
DB_PASSWORD=secret
# DB split (phase 1): schema-scoped roles the migration creates. The worker connects as
# clutch_worker (analytics.* + read-only public.matches); the api keeps the owner above.
DB_APP_PASSWORD=app_secret
DB_WORKER_PASSWORD=worker_secret

REDIS_HOST=redis
REDIS_PORT=6379
# Empty so Laravel doesn't prefix keys — Go BLPOPs the raw queue name below.
REDIS_PREFIX=

# MinIO speaks the S3 API, so Laravel's s3 driver just works
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=demos
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Plain Redis list both languages agree on (cross-language queue)
PARSE_QUEUE=demo_parse_jobs

# Sandbox limits on the untrusted-demo parse (a .dem is attacker-controlled input fed to
# a native parser). A crafted file can loop forever or allocate without bound; these cap
# one job's blast radius. Sized for a long 128-tick match with headroom — tighten in prod.
PARSE_TIMEOUT_SECONDS=300
PARSE_MEMORY_LIMIT_MB=2048
# Run each parse in a throwaway child process so a crash or exploit in the native parser
# is contained to that process, not the worker. Off in dev (air has no stable binary to
# exec; the in-process limits above still apply); turn ON in production.
PARSE_ISOLATION=false

# Pub/sub channel for events (worker + api publish; notifier and the Laravel
# events-listener both subscribe — one fact, many reactions)
EVENTS_CHANNEL=clutch_events

# Mail. `log` writes rendered emails to storage/logs (visible in Loki/Grafana) with no
# credentials — the whole events-listener → email pipeline works out of the box. Swap to
# smtp + host/port/username/password here (env only, never committed) to send for real.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@clutchlab.local
MAIL_FROM_NAME="${APP_NAME}"

# OTLP/HTTP endpoint Go services export traces to (host:port, no scheme)
OTEL_ENDPOINT=jaeger:4318
# Discord channel webhook the notifier posts to; empty = log-only mode
DISCORD_WEBHOOK_URL=

# Meilisearch (search read model). Shared by api (reader) and worker (writer).
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=masterKeyDev123

# Ask-the-analyst (RAG over your parsed matches). Leave the key empty to disable —
# the endpoint answers 503 analyst.unavailable. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Which generator answers questions. 'claude' is wired; bind 'ollama'/'llphant' in
# AppServiceProvider to use a local model behind the same contract.
ANALYST_PROVIDER=claude
# Semantic search (pgvector). 'hash' is keyless and needs nothing set, but only captures
# word overlap; 'ollama' is a real learned embedder served by the local ollama container
# (no account, no bill) and is what makes "long-range duels" find AWP matches.
#
# Switching between them means three steps, because the vector width changes with the
# model — hash follows EMBED_DIMENSIONS, nomic-embed-text is fixed at 768:
#   1. set EMBED_PROVIDER + EMBED_DIMENSIONS together
#   2. php artisan migrate      (resizes the column, wiping the old vectors)
#   3. php artisan analyst:embed  (rebuilds the projection with the new model)
EMBED_PROVIDER=hash
EMBED_DIMENSIONS=256
# For EMBED_PROVIDER=ollama, set EMBED_DIMENSIONS=768 and uncomment as needed
# (these are also the defaults in config/clutch.php):
# OLLAMA_HOST=http://ollama:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Filled in only once you write the matching embedder class:
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3
