<?xml version="1.0" encoding="UTF-8"?>
<!-- The api tests whose SQL needs Postgres (spec 004), against the throwaway server
     (docker-compose.yml's postgres-test, started with its "test" profile; a service container
     in CI), never the dev one. The commands are in api/docs/ENGINEERING.md, under Testing.
     Every other test stays in phpunit.xml, on in-memory sqlite.

     The database settings are <server> as well as <env> for phpunit.xml's reason: Compose's
     env_file puts the dev database in $_SERVER, and env() reads $_SERVER first. The guard in
     tests/Postgres/PostgresTestCase checks the server it reached before anything migrates.
     The credentials are the throwaway server's and guard nothing. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Postgres">
            <directory>tests/Postgres</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="postgres-test" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="clutchlab_test" force="true"/>
        <env name="DB_USERNAME" value="clutch_test" force="true"/>
        <env name="DB_PASSWORD" value="clutch_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_HOST" value="postgres-test" force="true"/>
        <server name="DB_PORT" value="5432" force="true"/>
        <server name="DB_DATABASE" value="clutchlab_test" force="true"/>
        <server name="DB_USERNAME" value="clutch_test" force="true"/>
        <server name="DB_PASSWORD" value="clutch_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <!-- The roles migration sets these roles' passwords on the server it runs on; without
             these lines the dev values would come in from $_SERVER. -->
        <server name="DB_APP_PASSWORD" value="clutch_test_app" force="true"/>
        <server name="DB_WORKER_PASSWORD" value="clutch_test_worker" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="OTEL_ENDPOINT" value=""/>
    </php>
</phpunit>
