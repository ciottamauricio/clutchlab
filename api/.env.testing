# Exists so Laravel's env bootstrapper has a file to read.
#
# This service deliberately has no api/.env (Compose env_file owns config — see
# api/CLAUDE.md). Dotenv's safeLoad() tolerates that, but PHP still emits a
# file_get_contents warning, and PHPUnit promotes it onto every single test — 74 warnings
# masking any real one. APP_ENV=testing (set in phpunit.xml) makes Laravel look for
# .env.testing first, so this file absorbs the read.
#
# It is intentionally near-empty and holds NO secrets: the values tests actually run on
# are in phpunit.xml, where the <server> overrides are what keep RefreshDatabase pointed
# at in-memory sqlite instead of the real Postgres.
APP_ENV=testing
