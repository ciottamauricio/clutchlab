# --- Secrets ---
.env

# --- Laravel (api/) ---
api/vendor/
api/node_modules/
api/public/storage
api/storage/*.key
api/storage/framework/cache/*
api/storage/framework/sessions/*
api/storage/framework/views/*
api/storage/logs/*
api/.env
api/.phpunit.result.cache

# --- Frontend (frontend/) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/

# --- Go services (worker/, realtime/) ---
# air builds to <svc>/tmp/; stray <svc>/<svc> comes from `go build ./...`
worker/tmp/
worker/*.exe
worker/worker
realtime/tmp/
realtime/*.exe
realtime/realtime

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
