// Grafana Alloy: the log-shipping agent. It discovers every container of this compose
// project via the Docker socket, tails their stdout, labels each line with the compose
// service name, and pushes to Loki. Services don't know it exists — no code changes.
//
// Labels are Loki's index and must stay LOW-cardinality (service names — a handful of
// values). Never label per-match/per-user data; that belongs in the log body
// (docs/ARCHITECTURE.md, Observability).

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
